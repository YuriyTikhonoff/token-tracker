{
  "name": "token-tracker-backend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "../.venv/bin/uvicorn token_tracker.main:app --reload --port 8765",
        "cwd": "token-tracker/backend"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "../.venv/bin/pytest -q -W error::DeprecationWarning",
        "cwd": "token-tracker/backend"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "../.venv/bin/ruff check .",
        "cwd": "token-tracker/backend"
      }
    }
  }
}
